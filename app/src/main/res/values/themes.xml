<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Caller" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryDark">@color/bg</item>
        <item name="colorAccent">@color/accent</item>
        <item name="colorControlNormal">@color/ink_2</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">@bool/light_bars</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/ink_2</item>
        <item name="android:textColorHint">@color/ink_3</item>
        <item name="alertDialogTheme">@style/Dialog.Caller</item>
        <item name="popupMenuStyle">@style/Popup.Caller</item>
        <item name="android:popupMenuStyle">@style/Popup.Caller</item>
    </style>

    <style name="Popup.Caller" parent="Widget.AppCompat.PopupMenu">
        <item name="android:popupBackground">@drawable/popup_bg</item>
    </style>

    <style name="Dialog.Caller" parent="Theme.AppCompat.DayNight.Dialog.Alert">
        <item name="colorAccent">@color/accent</item>
        <item name="android:windowBackground">@drawable/dialog_bg</item>
    </style>

    <style name="Theme.Caller.Call" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@drawable/call_gradient</item>
        <item name="android:statusBarColor">@color/call_bg_top</item>
        <item name="android:navigationBarColor">@color/call_bg</item>
        <item name="colorAccent">@color/go</item>
    </style>

    <style name="Dialog.Call" parent="Theme.AppCompat.Dialog.Alert">
        <item name="colorAccent">@color/go</item>
        <item name="android:windowBackground">@drawable/dialog_bg_dark</item>
    </style>

    <style name="IconBtn">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:background">@drawable/key_bg</item>
        <item name="android:scaleType">center</item>
        <item name="tint">@color/ink</item>
    </style>

    <style name="NavItem">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">?android:attr/selectableItemBackgroundBorderless</item>
    </style>

    <style name="NavIcon">
        <item name="android:layout_width">60dp</item>
        <item name="android:layout_height">32dp</item>
        <item name="android:background">@drawable/nav_pill</item>
        <item name="android:scaleType">center</item>
        <item name="android:duplicateParentState">true</item>
        <item name="tint">@color/nav_tint</item>
    </style>

    <style name="NavLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/nav_tint</item>
        <item name="android:duplicateParentState">true</item>
    </style>

    <style name="Ctrl">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center_horizontal</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="CtrlIcon">
        <item name="android:layout_width">68dp</item>
        <item name="android:layout_height">68dp</item>
        <item name="android:background">@drawable/ctrl_bg</item>
        <item name="android:scaleType">center</item>
        <item name="android:duplicateParentState">true</item>
        <item name="tint">@color/ctrl_tint</item>
    </style>

    <style name="CtrlLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/call_ink_2</item>
    </style>

    <style name="Section">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingTop">20dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:textColor">@color/accent</item>
        <item name="android:textSize">13sp</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
</resources>
